# Atlas + Expo quickstart. Expo exposes EXPO_PUBLIC_* vars to the app at build
# time. Copy to .env and fill in.

# Publishable key (safe to expose).
EXPO_PUBLIC_ATLAS_PUBLISHABLE_KEY=pk_test_xxx

# The instance's Frontend API origin.
EXPO_PUBLIC_ATLAS_FRONTEND_API=https://atlasauth.net

# The first-party OAuth client id used for the native token exchange. Register
# the app's redirect URI (atlasexpo://) on this client.
EXPO_PUBLIC_ATLAS_OAUTH_CLIENT_ID=client_xxx
